{
  "name": "@openlobster/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle ORM schema, migrations, and Postgres client factory for OpenLobster.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "echo 'lint: db package has no lint config'",
    "test": "echo 'no tests in db package'",
    "generate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "migrate": "tsx src/migrate.ts",
    "studio": "drizzle-kit studio",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openlobster/types": "*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  }
}
