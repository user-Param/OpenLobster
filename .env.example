# --- OpenLobster root .env.example ---
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# --- Database (durable state) ---
DATABASE_URL=postgres://openlobster:openlobster@localhost:5432/openlobster

# --- Redis (queue + cache + signals) ---
REDIS_URL=redis://localhost:6379

# --- Vector DB (retrieval index, NOT source of truth) ---
CHROMA_URL=http://localhost:8000

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-64-byte-hex
JWT_REFRESH_SECRET=replace-me-with-64-byte-hex
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Model providers (only fill what you use) ---
OPENAI_API_KEY=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
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Sandbox (Phase 2) ---
SANDBOX_IMAGE=openlobster/sandbox:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=2G
SANDBOX_DISK_LIMIT=10G
SANDBOX_TIMEOUT_SECONDS=600
SANDBOX_DRIVER=local
