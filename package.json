{
  "name": "openlobster",
  "version": "0.0.0",
  "private": true,
  "description": "OpenLobster — agentic coding assistant (control plane + execution plane).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up -d --wait && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "npm run --workspace=@openlobster/db generate",
    "db:push": "npm run --workspace=@openlobster/db push",
    "db:migrate": "npm run --workspace=@openlobster/db migrate",
    "db:studio": "npm run --workspace=@openlobster/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "allowScripts": {
    "argon2@0.41.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
